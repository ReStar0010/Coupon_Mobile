{
  "expo": {
    "name": "CouPro",
    "slug": "Mobile-Frontend",
    "version": "1.0.3",
    "scheme": ["coupro"],
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "允許 $(PRODUCT_NAME) 存取您的相機以掃描 QR Code"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CouPro 需要存取您的位置資訊，以便顯示附近的商家與優惠。",
          "locationAlwaysPermission": "CouPro 需要存取您的位置資訊，以便顯示附近的商家與優惠。",
          "locationWhenInUsePermission": "CouPro 需要存取您的位置資訊，以便顯示附近的商家與優惠。"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "consumer-frontend",
          "organization": "coupro"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/perf",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": ["RNFBApp", "RNFBAnalytics", "RNFBPerf"]
          }
        }
      ],
      "@sentry/react-native"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.cokayne.MobileFrontend",
      "associatedDomains": ["applinks:api.coupro.pro", "applinks:app.coupro.pro"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      "blockedPermissions": ["com.google.android.gms.permission.AD_ID"],
      "googleServicesFile": "./google-services.json",
      "package": "com.cokayne.MobileFrontend",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.coupro.pro",
              "pathPrefix": "/collection/"
            },
            {
              "scheme": "https",
              "host": "api.coupro.pro",
              "pathPrefix": "/claim/"
            },
            {
              "scheme": "https",
              "host": "api.coupro.pro",
              "pathPrefix": "/voucher/"
            },
            {
              "scheme": "https",
              "host": "app.coupro.pro",
              "pathPrefix": "/collection/"
            },
            {
              "scheme": "https",
              "host": "app.coupro.pro",
              "pathPrefix": "/claim/"
            },
            {
              "scheme": "https",
              "host": "app.coupro.pro",
              "pathPrefix": "/voucher/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyACVfhHwjl0L5QWVRUxWOyle4UOysZPSbA"
        }
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba247e6a-3cfa-4285-99f6-5867b5257c0e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ba247e6a-3cfa-4285-99f6-5867b5257c0e",
      "fallbackToCacheTimeout": 3000,
      "checkAutomatically": "ON_LOAD",
      "enabled": true
    }
  }
}
