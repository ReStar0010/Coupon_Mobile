{
  "name": "coupro-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "End-to-end Playwright suite. Two projects: web-app (Expo Web) + backend-landing (Django HTML pages).",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=web-app",
