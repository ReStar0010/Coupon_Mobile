{
  "cli": {
    "version": ">= 16.26.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://coupon-mobile.onrender.com"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://coupon-mobile.onrender.com"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://coupon-mobile.onrender.com"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
     "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      }
    }
  }
}
