{
  "expo": {
    "name": "CouPro 商家端",
    "slug": "Mobile-Merchant-Frontend",
    "version": "1.0.2",
    "scheme": ["coupromerchant"],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CouPro 需要存取您的位置資訊，以便自動填入您的店家位置，讓顧客能夠找到您的商店。",
          "locationAlwaysPermission": "CouPro 需要存取您的位置資訊，以便自動填入您的店家位置，讓顧客能夠找到您的商店。",
          "locationWhenInUsePermission": "CouPro 需要存取您的位置資訊，以便自動填入您的店家位置，讓顧客能夠找到您的商店。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CouPro 需要存取您的照片,以便讓您上傳商店標誌、商品圖片或優惠券圖片至您的商家資料。"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "merchant-frontend",
          "organization": "coupro"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/perf",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": ["RNFBApp", "RNFBAnalytics", "RNFBPerf"]
          }
        }
      ],
      "@sentry/react-native"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.cokayne.MobileMerchantFrontend",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#333333"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "com.cokayne.MobileMerchantFrontend",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyACVfhHwjl0L5QWVRUxWOyle4UOysZPSbA"
        }
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f19a569d-52b8-4052-9d9b-d8f009d33af2"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f19a569d-52b8-4052-9d9b-d8f009d33af2",
      "fallbackToCacheTimeout": 3000,
      "checkAutomatically": "ON_LOAD",
      "enabled": true
    }
  }
}
