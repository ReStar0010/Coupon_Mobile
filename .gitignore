# Playwright MCP cache + screenshots — generated by the MCP server when
# I drive Chrome via mcp__playwright__browser_*. Per-run debugging only.
.playwright-mcp/

# Test coverage artifacts (Backend pytest, FE Jest, both consumer apps).
# Coverage HTML/json is regenerated on every test run; never check in.
**/.coverage
**/coverage/

# Local debugging artifacts that historically landed at the repo root.
# Keep this list tight; if a new debug-helper script becomes durable,
# move it into a proper tools/ dir rather than adding it to .gitignore.
/screenshot-*.png
/app-home.png
/routing-audit.html
/package-lock.json

# Playwright report output (HTML report + trace.zip + video.webm bundles).
# The e2e/ folder has its own .gitignore for these but adding here as
# belt-and-suspenders covers root-relative runs too.
e2e/test-results/
e2e/playwright-report/