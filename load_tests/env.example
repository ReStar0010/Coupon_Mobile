# Copy to .env and set for your environment (used by run_load_test.sh).
# BASE_URL — Backend API base URL (no trailing slash)
BASE_URL=http://localhost:8000
# OUTPUT_DIR — Where to write CSV/HTML and consistency summary
OUTPUT_DIR=./load-test-results
# STAGE — 1–4
STAGE=1
# LOAD_TEST_SECRET — Required for remote load test: auth for /api/load-test/reset/ and verify-consistency/. Set same value on server (Backend) and client. Do not commit.
# LOAD_TEST_SECRET=your-secret-here
# LOAD_TEST_REMOTE — Set to 1 to force use of reset/verify APIs even if BASE_URL looks local
# LOAD_TEST_REMOTE=1
# DATABASE_URL — Required for reset and consistency (Backend). Use PostgreSQL for load tests.
# DATABASE_URL=postgres://user:password@localhost:5432/coupro
